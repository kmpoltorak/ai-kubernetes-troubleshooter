# Copy to .env and adjust. Never commit .env.

APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=info

# No login/provider needed when false (local, test and minikube).
AUTH_ENABLED=false
AUTH_PROXY_URL=http://127.0.0.1:4180
# Required when enabled. HTTPS, or HTTP on loopback for local auth tests only.
AUTH_PUBLIC_URL=
# Used by the optional Docker Compose auth profile; keep real values in .env.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
AUTH_COOKIE_SECRET=
OIDC_ALLOWED_GROUPS=troubleshooter-users

# Used by the app when running outside Docker Compose (make run).
# Docker Compose overrides this to point at the postgres service.
DATABASE_URL=postgres://troubleshooter:troubleshooter@localhost:5432/troubleshooter?sslmode=disable

# Live mode (SIMULATION_ENABLED=false): kubeconfig path and context. Empty
# KUBECONFIG uses ~/.kube/config, or the in-cluster ServiceAccount in a pod.
KUBECONFIG=
KUBERNETES_CONTEXT=
# The only value accepted in an incident's "cluster" field.
KUBERNETES_CLUSTER_NAME=local
# Comma-separated; empty allows every namespace the ServiceAccount can read.
KUBERNETES_ALLOWED_NAMESPACES=
# Extra kinds as group/version/resource, e.g. argoproj.io/v1alpha1/rollouts (status and selector only).
KUBERNETES_CUSTOM_RESOURCES=

# rules (offline, deterministic) | openai | anthropic | ollama
LLM_PROVIDER=rules
# Defaults: gpt-4o-mini (openai), claude-opus-5-5 (anthropic), llama3.2 (ollama)
LLM_MODEL=
LLM_TIMEOUT=60s
# Maximum serialized request body (bytes), including system prompt and schema.
LLM_MAX_INPUT_BYTES=262144
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# For make run; Docker Compose uses http://host.docker.internal:11434 (Ollama on the host).
OLLAMA_BASE_URL=http://localhost:11434

# healthy | crash_loop_backoff | image_pull_error | oom_killed |
# readiness_probe_failure | liveness_probe_failure | missing_configmap |
# service_selector_mismatch | dns_failure | resource_pressure | network_policy_block
SIMULATION_ENABLED=true
SIMULATION_SCENARIO=healthy

JOB_TIMEOUT=15m
JOB_QUEUE_CAPACITY=100
INVESTIGATION_TIMEOUT=90s
MAX_CONCURRENT_INVESTIGATIONS=4
RATE_LIMIT_RPS=5
