# Copy to .env and adjust. Never commit .env.
# The first block lists every setting that can be required; each comment says
# when. Everything below has a working default.

# ---- Required ----------------------------------------------------------------

# Your PostgreSQL, e.g. postgres://troubleshooter:PASSWORD@db.example.net:5432/troubleshooter?sslmode=require
# Inside Docker, localhost is the container. Without one, use docker-compose.test-db.yml
# (README) or make test-db for a throwaway database.
DATABASE_URL=

# Analyzer: rules (offline, deterministic, no key) | openai | anthropic | gemini.
LLM_PROVIDER=rules
# Required for openai, anthropic and gemini: an exact model name. Startup checks it
# against the provider's model list for the key and lists the available ones if not.
LLM_MODEL=
# The key for the chosen provider; environment only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Required only when AUTH_ENABLED=true: HTTPS, or HTTP on loopback for local auth tests.
AUTH_PUBLIC_URL=

# ---- Optional (defaults shown) ------------------------------------------------

APP_ENV=development
# With Docker Compose, the host port.
HTTP_PORT=8080
LOG_LEVEL=info

# Analysis
# Reasoning effort: low | medium | high work for every provider; other values are
# passed through as the provider defines them. off: no effort parameter, for
# models without reasoning (OpenAI then gets temperature 0).
LLM_REASONING_EFFORT=medium
# Output limit per analysis, thinking included (1-128000).
LLM_MAX_OUTPUT_TOKENS=16000
LLM_TIMEOUT=300s
# Maximum serialized request body (bytes), including system prompt and schema.
LLM_MAX_INPUT_BYTES=262144
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Clusters. Simulation needs none; for a live cluster set SIMULATION_ENABLED=false.
# healthy | crash_loop_backoff | image_pull_error | oom_killed |
# readiness_probe_failure | liveness_probe_failure | missing_configmap |
# service_selector_mismatch | dns_failure | resource_pressure | network_policy_block
SIMULATION_ENABLED=true
SIMULATION_SCENARIO=healthy
# Empty KUBECONFIG uses ~/.kube/config, or the in-cluster ServiceAccount in a pod.
KUBECONFIG=
KUBERNETES_CONTEXT=
# The only value accepted in an incident's "cluster" field. Empty: the cluster
# name of the kubeconfig context (live), or local (simulation).
KUBERNETES_CLUSTER_NAME=
# Comma-separated; empty allows every namespace the ServiceAccount can read.
KUBERNETES_ALLOWED_NAMESPACES=
# Several clusters: a YAML file replacing KUBERNETES_CONTEXT, KUBERNETES_CLUSTER_NAME
# and KUBERNETES_ALLOWED_NAMESPACES (docs/clusters.md).
KUBERNETES_CLUSTERS_FILE=
# Extra kinds as group/version/resource, e.g. argoproj.io/v1alpha1/rollouts (status and selector only).
KUBERNETES_CUSTOM_RESOURCES=

# Docker Compose override files (README); each variable is read only by the file named.
# docker-compose.live.yml: kubeconfig on the host, readable by the container's uid 65532.
KUBECONFIG_FILE=
# docker-compose.clusters.yml: directory with clusters.yaml and the kubeconfigs it names.
KUBE_DIR=
# docker-compose.external-db.yml: Docker network of a PostgreSQL container on this host.
EXTERNAL_DATABASE_NETWORK=
# docker-compose.test-db.yml: password of the throwaway database (URL-safe characters).
TEST_DB_PASSWORD=troubleshooter

# Login (no identity provider needed when false: local, test and minikube).
AUTH_ENABLED=false
AUTH_PROXY_URL=http://127.0.0.1:4180
# Used by the optional Docker Compose auth profile; keep real values in .env.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
AUTH_COOKIE_SECRET=
OIDC_ALLOWED_GROUPS=troubleshooter-users

# Jobs and limits
JOB_TIMEOUT=15m
JOB_QUEUE_CAPACITY=100
# Longer than LLM_TIMEOUT: one attempt covers the diagnostics and the analysis.
INVESTIGATION_TIMEOUT=360s
MAX_CONCURRENT_INVESTIGATIONS=4
RATE_LIMIT_RPS=5
