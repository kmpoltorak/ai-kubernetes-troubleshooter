# Copy to .env and adjust. Never commit .env.
# Only the first block is required; everything below has a working default.

# ---- Required ----------------------------------------------------------------

# PostgreSQL for make run; Docker Compose overrides it to point at its postgres service.
DATABASE_URL=postgres://troubleshooter:troubleshooter@localhost:5432/troubleshooter?sslmode=disable

# Analyzer: rules (offline, deterministic, no key) | openai | anthropic | gemini.
LLM_PROVIDER=rules
# Required for openai, anthropic and gemini: an exact model name. Startup checks it
# against the provider's model list for the key and lists the available ones if not.
LLM_MODEL=
# The key for the chosen provider; environment only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Required only when AUTH_ENABLED=true: HTTPS, or HTTP on loopback for local auth tests.
AUTH_PUBLIC_URL=

# ---- Optional (defaults shown) ------------------------------------------------

APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=info

# Analysis
# Reasoning effort for every provider: low | medium | high | off (off: no effort
# parameter, for models without reasoning; OpenAI then gets temperature 0).
LLM_REASONING_EFFORT=medium
# Output limit per analysis, thinking included (1-128000).
LLM_MAX_OUTPUT_TOKENS=16000
LLM_TIMEOUT=300s
# Maximum serialized request body (bytes), including system prompt and schema.
LLM_MAX_INPUT_BYTES=262144
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Clusters. Simulation needs none; for a live cluster set SIMULATION_ENABLED=false.
# healthy | crash_loop_backoff | image_pull_error | oom_killed |
# readiness_probe_failure | liveness_probe_failure | missing_configmap |
# service_selector_mismatch | dns_failure | resource_pressure | network_policy_block
SIMULATION_ENABLED=true
SIMULATION_SCENARIO=healthy
# Empty KUBECONFIG uses ~/.kube/config, or the in-cluster ServiceAccount in a pod.
KUBECONFIG=
KUBERNETES_CONTEXT=
# The only value accepted in an incident's "cluster" field.
KUBERNETES_CLUSTER_NAME=local
# Comma-separated; empty allows every namespace the ServiceAccount can read.
KUBERNETES_ALLOWED_NAMESPACES=
# Extra kinds as group/version/resource, e.g. argoproj.io/v1alpha1/rollouts (status and selector only).
KUBERNETES_CUSTOM_RESOURCES=

# Login (no identity provider needed when false: local, test and minikube).
AUTH_ENABLED=false
AUTH_PROXY_URL=http://127.0.0.1:4180
# Used by the optional Docker Compose auth profile; keep real values in .env.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
AUTH_COOKIE_SECRET=
OIDC_ALLOWED_GROUPS=troubleshooter-users

# Jobs and limits
JOB_TIMEOUT=15m
JOB_QUEUE_CAPACITY=100
# Longer than LLM_TIMEOUT: one attempt covers the diagnostics and the analysis.
INVESTIGATION_TIMEOUT=360s
MAX_CONCURRENT_INVESTIGATIONS=4
RATE_LIMIT_RPS=5
